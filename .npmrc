# next-auth@4.x는 nodemailer ^7을 peerOptional로 선언하지만 실제로는 사용하지 않음
# (EmailProvider 미사용). nodemailer 8 보안 업그레이드 유지를 위해 peer 충돌을 무시.
# npm 11의 ERESOLVE로 Vercel 클린 설치가 실패하는 것을 방지.
legacy-peer-deps=true

# file: 의존성(@oripics/certificate)을 심링크가 아닌 복사로 설치 — 심링크면 Next의
# serverExternalPackages 외부화가 적용되지 않아 PDF 렌더가 React error #31로 실패 (2026-08-28)
install-links=true
