generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?
  refresh_token_expires_in Int?    // 카카오 전용 필드 추가

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // 암호화된 비밀번호 저장용 필드

  // 요금제 / 크레딧 (J-1, 2026-05-10)
  // tier: "free" | "pro" | "business" — pricing-policy.md 참조
  tier              String    @default("free")
  credits           Int       @default(0)
  // 크레딧 다음 갱신 시점 (가입일 기준 매월). null = 미초기화 (기존 사용자) → J-2 마이그레이션 시 보정
  creditsRenewAt    DateTime?

  // 파트너 릴레이 챌린지 (A-82, 2026-09-10) — docs/partner-relay-challenge-plan.md
  partnerCode            String?   @unique          // 숫자 코드. 대표 1234, 일반 1235~, 제휴사 100~999 수동
  partnerJoinedAt        DateTime?                  // 코드 입력·참여 확정 시각 (500명 카운트 기준)
  partnerRank            Int?                       // 1~500 파트너 순번. 501+ null(비파트너)
  referredById           String?                    // 입력한 코드의 주인
  firstChargeBonusUsedAt DateTime?                  // 첫 결제 2장 혜택 사용 시각(계정당 1회)

  accounts      Account[]
  sessions      Session[]
  proofs        ProofHistory[]
  creditTransactions CreditTransaction[]
  subscription  Subscription?
  mobileRefreshTokens MobileRefreshToken[]
  dayPassesPurchased DayPass[] @relation("DayPassPurchaser")
  dayPassesRedeemed  DayPass[] @relation("DayPassRedeemer")
  referredBy         User?     @relation("PartnerReferredBy", fields: [referredById], references: [id], onDelete: SetNull)
  referredUsers      User[]    @relation("PartnerReferredBy")
  partnerReferralsMade     PartnerReferral[] @relation("ReferralReferrer")
  partnerReferralReceived  PartnerReferral?  @relation("ReferralReferee")
  partnerBenefits    PartnerBenefit[]
  chargeIntents      ChargeIntent[]
  partnerMilestone   PartnerMilestone?

  @@index([referredById])
  @@index([partnerRank])
}

// 모바일 refresh 토큰 서버측 상태 (A-38②, 2026-08-24)
// 기존 무상태 회전은 유출 시 개별 폐기가 불가능했음 — jti 단위로 발급을 기록해
// 회전 시 구 토큰을 폐기하고, 폐기된 토큰 재사용(탈취 신호) 감지 시 사용자 전체 세션을 무효화한다.
// ⚠️ 테이블 생성은 raw SQL로 수행 (prisma db push 금지 — 스키마 밖 links 테이블을 드롭하려 함)
model MobileRefreshToken {
  jti       String    @id
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("mobile_refresh_tokens")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model ProofHistory {
  id              String   @id @default(cuid())
  userId          String
  linkId          String   @unique
  thumbnail       String?  // Supabase Storage URL
  width           Int
  height          Int
  timestamp       String   // 스테가노그래피 타임스탬프 (proof 시점)
  createdAt       DateTime @default(now())  // publish 시점 (B-2 흐름)
  passId          String?  // 원데이 패스로 발행 시 패스 id (A-60 — 목록탭 태그)
  // 증명서 PDF 캐시 경로 (Supabase Storage). 발급 후 재다운로드 무료, 재발급 시 -10 차감.
  pdfStoragePath  String?
  pdfIssuedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// 크레딧 변동 이력 (J-1, 2026-05-10)
// delta 양수 = 충전·갱신, 음수 = 차감
// action 종류: signup_grant | monthly_renewal | image_proof | verify_query | link_create | verified_proof | subscription_grant | manual_adjust
model CreditTransaction {
  id           String   @id @default(cuid())
  userId       String
  delta        Int
  action       String
  balanceAfter Int
  metadata     Json?    // 액션별 추가 컨텍스트 (예: { linkId, gatewayPaymentId, planId })
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// 결제 구독 (J-1, 2026-05-10) — 게이트웨이 무관 도메인 모델
// gateway: "portone" | "stripe" — 추상화 레이어와 매핑
// plan: "pro_monthly" | "pro_yearly" | "business_monthly"
// status: "active" | "past_due" | "canceled" | "incomplete"
model Subscription {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  gateway                  String
  gatewayCustomerId        String
  gatewaySubscriptionId    String?
  billingKey               String?
  plan                     String
  status                   String
  currentPeriodStart       DateTime
  currentPeriodEnd         DateTime
  cancelAtPeriodEnd        Boolean  @default(false)
  canceledAt               DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gatewayCustomerId])
  @@index([gatewaySubscriptionId])
}

/// 원데이 패스 (A-60, 2026-08-31) — 선물 가능 1일 이용권.
/// ⚠️ 테이블 생성은 raw SQL (db_migrations/2026_08_31_day_pass.sql) — prisma db push 금지.
/// 계정당 활성 1장은 partial unique index(day_pass_one_active, status='redeemed')로 DB에서 강제.
/// status: issued(미등록) | redeemed(활성) | exhausted(10회 소진) | expired(24h 경과) | revoked(환불 등)
model DayPass {
  id             String    @id @default(cuid())
  code           String    @unique
  status         String    @default("issued")
  purchaserId    String?   @map("purchaser_id")
  redeemerId     String?   @map("redeemer_id")
  issuedAt       DateTime  @default(now()) @map("issued_at")
  codeExpiresAt  DateTime  @map("code_expires_at")
  redeemedAt     DateTime? @map("redeemed_at")
  expiresAt      DateTime? @map("expires_at")
  totalProofs    Int       @default(10) @map("total_proofs")
  usedProofs     Int       @default(0) @map("used_proofs")
  paymentId      String?   @map("payment_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  purchaser User? @relation("DayPassPurchaser", fields: [purchaserId], references: [id], onDelete: SetNull)
  redeemer  User? @relation("DayPassRedeemer", fields: [redeemerId], references: [id], onDelete: SetNull)

  @@index([redeemerId])
  @@map("day_passes")
}

/// 레이트리밋 fixed-window 카운터 (2026-08-22 보안 점검).
/// 서버리스 in-memory가 무효라 DB 원자 UPSERT로 집계. cleanup cron이 오래된 행 정리.
model RateLimit {
  key         String
  windowStart DateTime @map("window_start")
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limits")
}

// ─── 파트너 릴레이 챌린지 (A-82) — db_migrations/2026_09_10_partner_relay.sql ───

model PartnerReferral {
  id               String   @id @default(cuid())
  referrerId       String   @map("referrer_id")
  refereeId        String   @unique @map("referee_id")
  status           String   @default("confirmed")            // confirmed | revoked
  referrerRewarded Boolean  @default(false) @map("referrer_rewarded")
  ipHash           String?  @map("ip_hash")
  riskFlags        Json?    @map("risk_flags")
  revokedReason    String?  @map("revoked_reason")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  referrer User @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("ReferralReferee", fields: [refereeId], references: [id], onDelete: Cascade)
  benefits PartnerBenefit[]

  @@index([referrerId, createdAt])
  @@index([ipHash, createdAt])
  @@map("partner_referrals")
}

model PartnerBenefit {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  type          String                                        // pro_50 | pro_free_month
  source        String                                        // signup | referral | milestone_12 | admin
  referralId    String?   @map("referral_id")
  status        String    @default("available")               // available | reserved | used | expired | revoked
  issuedAt      DateTime  @default(now()) @map("issued_at")
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  paymentId     String?   @map("payment_id")
  revokedReason String?   @map("revoked_reason")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  referral PartnerReferral? @relation(fields: [referralId], references: [id], onDelete: SetNull)

  @@index([userId, status, expiresAt])
  @@index([paymentId])
  @@map("partner_benefits")
}

model ChargeIntent {
  paymentId      String   @id @map("payment_id")
  userId         String   @map("user_id")
  plan           String
  listAmount     Int      @map("list_amount")
  discountAmount Int      @default(0) @map("discount_amount")
  expectedAmount Int      @map("expected_amount")
  benefitIds     Json     @default("[]") @map("benefit_ids")
  status         String   @default("pending")                 // pending | paid | failed
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("charge_intents")
}

model PartnerMilestone {
  userId       String    @id @map("user_id")
  reachedAt    DateTime  @default(now()) @map("reached_at")
  notifiedAt   DateTime? @map("notified_at")
  approvedAt   DateTime? @map("approved_at")
  approvedBy   String?   @map("approved_by")
  rejectedAt   DateTime? @map("rejected_at")
  rejectReason String?   @map("reject_reason")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("partner_milestones")
}

/// 참여 이력 원장 — 탈퇴·재가입 반복 적립 차단 (이메일당 평생 1회). FK 없음(User 삭제와 무관)
model PartnerJoinLedger {
  emailHash      String    @id @map("email_hash")
  firstUserId    String?   @map("first_user_id")
  referrerId     String?   @map("referrer_id")
  referrerCode   String?   @map("referrer_code")
  joinedAt       DateTime  @default(now()) @map("joined_at")
  rejoinAttempts Int       @default(0) @map("rejoin_attempts")
  lastAttemptAt  DateTime? @map("last_attempt_at")

  @@map("partner_join_ledger")
}
