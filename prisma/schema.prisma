generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?
  refresh_token_expires_in Int?    // 카카오 전용 필드 추가

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // 암호화된 비밀번호 저장용 필드

  // 요금제 / 크레딧 (J-1, 2026-05-10)
  // tier: "free" | "pro" | "business" — pricing-policy.md 참조
  tier              String    @default("free")
  credits           Int       @default(0)
  // 크레딧 다음 갱신 시점 (가입일 기준 매월). null = 미초기화 (기존 사용자) → J-2 마이그레이션 시 보정
  creditsRenewAt    DateTime?

  accounts      Account[]
  sessions      Session[]
  proofs        ProofHistory[]
  creditTransactions CreditTransaction[]
  subscription  Subscription?
  mobileRefreshTokens MobileRefreshToken[]
  dayPassesPurchased DayPass[] @relation("DayPassPurchaser")
  dayPassesRedeemed  DayPass[] @relation("DayPassRedeemer")
}

// 모바일 refresh 토큰 서버측 상태 (A-38②, 2026-08-24)
// 기존 무상태 회전은 유출 시 개별 폐기가 불가능했음 — jti 단위로 발급을 기록해
// 회전 시 구 토큰을 폐기하고, 폐기된 토큰 재사용(탈취 신호) 감지 시 사용자 전체 세션을 무효화한다.
// ⚠️ 테이블 생성은 raw SQL로 수행 (prisma db push 금지 — 스키마 밖 links 테이블을 드롭하려 함)
model MobileRefreshToken {
  jti       String    @id
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("mobile_refresh_tokens")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model ProofHistory {
  id              String   @id @default(cuid())
  userId          String
  linkId          String   @unique
  thumbnail       String?  // Supabase Storage URL
  width           Int
  height          Int
  timestamp       String   // 스테가노그래피 타임스탬프 (proof 시점)
  createdAt       DateTime @default(now())  // publish 시점 (B-2 흐름)
  passId          String?  // 원데이 패스로 발행 시 패스 id (A-60 — 목록탭 태그)
  // 증명서 PDF 캐시 경로 (Supabase Storage). 발급 후 재다운로드 무료, 재발급 시 -10 차감.
  pdfStoragePath  String?
  pdfIssuedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// 크레딧 변동 이력 (J-1, 2026-05-10)
// delta 양수 = 충전·갱신, 음수 = 차감
// action 종류: signup_grant | monthly_renewal | image_proof | verify_query | link_create | verified_proof | subscription_grant | manual_adjust
model CreditTransaction {
  id           String   @id @default(cuid())
  userId       String
  delta        Int
  action       String
  balanceAfter Int
  metadata     Json?    // 액션별 추가 컨텍스트 (예: { linkId, gatewayPaymentId, planId })
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// 결제 구독 (J-1, 2026-05-10) — 게이트웨이 무관 도메인 모델
// gateway: "portone" | "stripe" — 추상화 레이어와 매핑
// plan: "pro_monthly" | "pro_yearly" | "business_monthly"
// status: "active" | "past_due" | "canceled" | "incomplete"
model Subscription {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  gateway                  String
  gatewayCustomerId        String
  gatewaySubscriptionId    String?
  billingKey               String?
  plan                     String
  status                   String
  currentPeriodStart       DateTime
  currentPeriodEnd         DateTime
  cancelAtPeriodEnd        Boolean  @default(false)
  canceledAt               DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gatewayCustomerId])
  @@index([gatewaySubscriptionId])
}

/// 원데이 패스 (A-60, 2026-08-31) — 선물 가능 1일 이용권.
/// ⚠️ 테이블 생성은 raw SQL (db_migrations/2026_08_31_day_pass.sql) — prisma db push 금지.
/// 계정당 활성 1장은 partial unique index(day_pass_one_active, status='redeemed')로 DB에서 강제.
/// status: issued(미등록) | redeemed(활성) | exhausted(10회 소진) | expired(24h 경과) | revoked(환불 등)
model DayPass {
  id             String    @id @default(cuid())
  code           String    @unique
  status         String    @default("issued")
  purchaserId    String?   @map("purchaser_id")
  redeemerId     String?   @map("redeemer_id")
  issuedAt       DateTime  @default(now()) @map("issued_at")
  codeExpiresAt  DateTime  @map("code_expires_at")
  redeemedAt     DateTime? @map("redeemed_at")
  expiresAt      DateTime? @map("expires_at")
  totalProofs    Int       @default(10) @map("total_proofs")
  usedProofs     Int       @default(0) @map("used_proofs")
  graceAppliedAt DateTime? @map("grace_applied_at")
  paymentId      String?   @map("payment_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  purchaser User? @relation("DayPassPurchaser", fields: [purchaserId], references: [id], onDelete: SetNull)
  redeemer  User? @relation("DayPassRedeemer", fields: [redeemerId], references: [id], onDelete: SetNull)

  @@index([redeemerId])
  @@map("day_passes")
}

/// 레이트리밋 fixed-window 카운터 (2026-08-22 보안 점검).
/// 서버리스 in-memory가 무효라 DB 원자 UPSERT로 집계. cleanup cron이 오래된 행 정리.
model RateLimit {
  key         String
  windowStart DateTime @map("window_start")
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limits")
}
